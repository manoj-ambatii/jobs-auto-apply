{
  "name": "jobs-auto-apply",
  "version": "1.0.0",
  "description": "Playwright & Playwright MCP powered multi-platform job application and tracking system",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/cli.js --help",
    "apply:linkedin": "node src/cli.js apply --platform linkedin",
    "apply:naukri": "node src/cli.js apply --platform naukri",
    "apply:all": "node src/cli.js apply --platform all",
    "apply:linkedin:headed": "node src/cli.js apply --platform linkedin --mode headed",
    "apply:naukri:headed": "node src/cli.js apply --platform naukri --mode headed",
    "apply:naukri:java": "node src/cli.js apply --platform naukri --mode headed --keywords \"Java Developer\" --no-cap",
    "apply:naukri:nocap": "node src/cli.js apply --platform naukri --mode headed --no-cap",
    "apply:linkedin:headless": "node src/cli.js apply --platform linkedin --mode headless",
    "apply:naukri:headless": "node src/cli.js apply --platform naukri --mode headless",
    "tracker:stats": "node src/cli.js stats",
    "tracker:list": "node src/cli.js list",
    "tracker:export": "node src/cli.js export",
    "tracker:import": "node src/cli.js import",
    "mcp:headed": "npx @playwright/mcp@latest",
    "mcp:headless": "npx @playwright/mcp@latest --headless"
  },
  "keywords": [
    "playwright",
    "mcp",
    "jobs-auto-apply",
    "linkedin",
    "naukri",
    "automation",
    "tracker"
  ],
  "author": "Manoj Ambati",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@playwright/mcp": "^0.0.70",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "googleapis": "^182.0.0",
    "playwright": "^1.47.0",
    "xlsx": "^0.18.5"
  }
}
